{
  "name": "inventory-mobile",
  "version": "1.0.0",
  "description": "进销存管理系统移动端 (Uniapp + Vue3)",
  "main": "main.js",
  "scripts": {
    "dev:app": "uni -p app",
    "dev:h5": "node -e \"process.env.UNI_INPUT_DIR='.'; require('child_process').execSync('uni', {stdio: 'inherit'})\"",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:app": "node -e \"process.env.UNI_INPUT_DIR='.'; require('child_process').execSync('uni build -p app', {stdio: 'inherit'})\"",
    "build:h5": "node -e \"process.env.UNI_INPUT_DIR='.'; require('child_process').execSync('uni build', {stdio: 'inherit'})\"",
    "build:mp-weixin": "uni build -p mp-weixin"
  },
  "dependencies": {
    "@dcloudio/uni-ui": "^1.5.12",
    "dayjs": "^1.11.10",
    "pinia": "^2.1.7",
    "uview-plus": "^3.4.6"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.4",
    "@dcloudio/uni-app": "^3.0.0-5000720260410001",
    "@dcloudio/uni-h5": "^3.0.0-5000720260410001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-5000720260410001",
    "@dcloudio/vite-plugin-uni": "^3.0.0-5000720260410001",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "vite": "^5.2.8",
    "vue": "^3.3.8"
  }
}
